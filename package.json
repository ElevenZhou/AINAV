{
  "name": "ai-dazi-nav",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/web",
    "apps/api"
  ],
  "scripts": {
    "dev:web": "npm run dev -w apps/web",
    "dev:api": "npm run start:dev -w apps/api",
    "build:web": "npm run build -w apps/web",
    "build:api": "npm run build -w apps/api",
    "lint:web": "npm run lint -w apps/web",
    "check:regression:win": "powershell -ExecutionPolicy Bypass -File scripts/regression-check.ps1",
    "bootstrap:db:win": "powershell -ExecutionPolicy Bypass -File scripts/bootstrap-db-meili.ps1",
    "stop:local": "powershell -ExecutionPolicy Bypass -File scripts/stop-local.ps1",
    "start:infra": "docker compose -f infra/docker-compose.yml up -d",
    "stop:infra": "docker compose -f infra/docker-compose.yml down"
  }
}
