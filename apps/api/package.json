{
  "name": "@aidazi/api",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "start:dev": "nest start --watch",
    "build": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\" && nest build",
    "start": "node dist/src/main.js",
    "lint": "eslint \"src/**/*.ts\"",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:seed": "ts-node --project tsconfig.json prisma/seed.ts",
    "db:setup": "prisma migrate deploy && prisma db seed"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.0.3",
    "@nestjs/config": "4.0.0",
    "@nestjs/core": "11.0.3",
    "@nestjs/platform-express": "11.0.3",
    "@prisma/client": "6.3.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "meilisearch": "^0.46.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.2",
    "@nestjs/schematics": "11.0.1",
    "@nestjs/testing": "11.0.3",
    "@types/express": "5.0.0",
    "@types/node": "22.12.0",
    "eslint": "9.18.0",
    "prisma": "6.3.1",
    "ts-node": "10.9.2",
    "typescript": "5.7.3"
  }
}
